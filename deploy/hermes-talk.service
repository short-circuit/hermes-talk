# Hermes Talk voice relay — systemd deployment.
#
# Install as /etc/systemd/system/hermes-talk.service. This is the alternative to
# the compose stack in deploy/compose.yaml: run one or the other, never both,
# because both bind 127.0.0.1:8790.
#
# TLS terminates at the reverse proxy (deploy/Caddyfile), so this unit binds
# loopback only and never needs a certificate. Setup, health gate, and rollback
# are documented in docs/DEPLOYMENT.md.

[Unit]
Description=Hermes Talk voice relay
Documentation=file:///opt/hermes-talk/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
# The relay calls only loopback services, but the Hermes API server and the
# voice-brain server must be reachable before the first turn is attempted.

[Service]
Type=simple
User=hermes-talk
Group=hermes-talk
EnvironmentFile=/etc/hermes-talk/relay.env
WorkingDirectory=/opt/hermes-talk
ExecStart=/opt/hermes-talk/.venv/bin/python -m relay.app
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# /var/lib/hermes-talk is created for the service user and stays writable under
# ProtectSystem=strict. OUTBOX_DIR must exist before start-up (the relay never
# creates it): install -d -o hermes-talk -g hermes-talk -m 0700 \
#   /var/lib/hermes-talk/outbox
StateDirectory=hermes-talk
StateDirectoryMode=0700

# Hardening: no privileges, no devices, no home directory, no write access
# outside the state directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
