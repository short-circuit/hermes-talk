# Copy to .env and fill in. Never commit .env.
# All endpoints are expected to be reachable on your LAN only.

# Hermes API server (OpenAI-compatible). Bind to loopback on the relay host.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me

# Optional session key forwarded as X-Hermes-Session-Key.
HERMES_SESSION_KEY=change-me

# Local inference / speech services
LOCALAI_BASE_URL=http://127.0.0.1:8081
VOICE_BRAIN_MODEL=lfm3-1.7b
# Voice-brain router endpoint. Point this at a loopback llama-server started
# with --jinja; the router only speaks the OpenAI chat-completions API.
VOICE_BRAIN_BASE_URL=http://127.0.0.1:8080
VOICE_BRAIN_TEMPERATURE=0.1
VOICE_BRAIN_MAX_TOKENS=160
# "required" forces one tool call per turn; "auto" lets the model answer in text.
VOICE_BRAIN_TOOL_CHOICE=required
# Conditional exposure of attach_file: llama.cpp 0.8.0 has no deferred tool loading.
VOICE_BRAIN_DEFERRED_TOOLS=0
VOICE_BRAIN_FIRST_TOKEN_TIMEOUT_S=2.0
VOICE_BRAIN_REQUEST_TIMEOUT_S=20.0
VOICE_BRAIN_MAX_UTTERANCE_CHARS=2000
STT_MODEL=whisper-1
TTS_MODEL=kokoro
VAD_MODEL=silero-vad

# Relay. Bind loopback: TLS terminates at the reverse proxy, so the relay
# itself speaks plain HTTP and is reachable only from this host.
RELAY_HOST=127.0.0.1
RELAY_PORT=8790

# Deployment (deploy/compose.yaml, deploy/Caddyfile). Not read by the relay.
# Site name served with the proxy's internal CA; must resolve on every client
# through a hosts-file entry or LAN DNS, and may carry a :port when 443 is taken.
RELAY_SITE_ADDRESS=voice.example.lan
# Host directory with the speech models; mounted read-only at /models.
HERMES_TALK_MODELS=/srv/hermes-talk/models
# Image tag for the compose build; pin the git short sha for a rollback target.
RELAY_IMAGE=hermes-talk-relay:local

# Device auth (DEPRECATED bootstrap fallback).
# Comma-separated bearer tokens, one per device. Consulted only while the token
# state file has no active tokens. Prefer `python -m relay.tokens issue`.
DEVICE_TOKENS=bootstrap-token-placeholder

# Storage (outside the repo). Logs, audit entries and recordings live here.
INBOX_DIR=/var/lib/hermes-talk/inbox
OUTBOX_DIR=/var/lib/hermes-talk/outbox
DATA_DIR=/var/lib/hermes-talk

# Hash-only device token state. Optional; defaults to $DATA_DIR/device_tokens.json.
# Keep it outside the git work tree.
TOKEN_STATE_PATH=/var/lib/hermes-talk/device_tokens.json

# Limits
MAX_ATTACHMENT_MB=50
MAX_CALL_MINUTES=60

# Logging: structured logs stay local and are bounded/redacted.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TRANSCRIPT_MAX_CHARS=280

# Retention knobs (age in days, size in bytes, rotated backups to keep).
LOG_MAX_AGE_DAYS=14
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
AUDIT_MAX_AGE_DAYS=90
AUDIT_MAX_BYTES=5242880
AUDIT_BACKUP_COUNT=10

# Spoken approval hardening (T-26/T-27/T-28). The confirmation phrase must name
# the action; a bare "yes" never approves. Raise the confidence floor or lengthen
# the phrase to trade more false denies (the user repeats) for fewer false accepts
# (a TV or bystander approving). APPROVAL_ECHO_GUARD=1 keeps the window closed
# while TTS is speaking so the relay cannot transcribe its own "yes".
APPROVAL_CONFIRMATION_PHRASE=yes run it
APPROVAL_MIN_CONFIDENCE=0.6
APPROVAL_MAX_REASKS=1
APPROVAL_ECHO_GUARD=1
APPROVAL_TIMEOUT_S=20.0

# Optional audio debug recordings under $DATA_DIR/recordings. Off by default.
RECORD_AUDIO=0

# Admission control and rate limits. Every value has a safe local-only default;
# raise them deliberately, never per request. Rejections return 429 or 503 with
# a short `spoken` sentence so the client can render it through local TTS; audio
# is never silently dropped. /ready exposes queue depth only (no tokens, no paths).
MAX_CONCURRENT_SESSIONS=3
MAX_CONCURRENT_RUNS=2
MAX_CONCURRENT_RUNS_PER_DEVICE=1
MAX_CONCURRENT_UPLOADS=2
MAX_QUEUED_UPLOADS=8
SESSION_IDLE_TIMEOUT_SECONDS=120.0
SESSION_REAPER_INTERVAL_SECONDS=5.0
# Per-device token bucket budgets; burst must not exceed per-minute.
RATE_LIMIT_RUN_PER_MINUTE=20
RATE_LIMIT_RUN_BURST=5
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_UPLOAD_BURST=10
RATE_LIMIT_DOWNLOAD_PER_MINUTE=120
RATE_LIMIT_DOWNLOAD_BURST=30
# Bound on tracked per-device buckets (LRU eviction; no unbounded growth).
RATE_LIMIT_MAX_DEVICES=64
# SSE hygiene: frame cap, idle timeout, and bounded reconnects per session.
MAX_SSE_FRAME_BYTES=65536
SSE_IDLE_TIMEOUT_SECONDS=30.0
SSE_MAX_RECONNECT_ATTEMPTS=5
# Barge-in debounce: ignore short noise, allow one stop per cooldown window.
BARGE_IN_MIN_SPEECH_MS=300
BARGE_IN_COOLDOWN_MS=1000
# Retry-After advertised on admission rejections.
REJECT_RETRY_AFTER_SECONDS=2

# Local speech I/O. No cloud calls; point these at model directories outside
# the repository. Install the adapters with `./relay[speech]`.
STT_ENGINE=sherpa
STT_MODEL_DIR=models/sherpa-onnx-streaming-zipformer-en-2023-06-26
STT_NUM_THREADS=4
STT_PARTIAL_INTERVAL_MS=120
# Synthetic trailing silence so the streaming decoder finishes the last words; 0 disables it and truncates the transcript.
STT_FLUSH_PADDING_MS=480
WHISPER_MODEL_DIR=models/faster-whisper-base
WHISPER_CHUNK_MS=2000
TTS_ENGINE=kokoro
TTS_MODEL_PATH=models/kokoro-v1.0.int8.onnx
TTS_VOICES_PATH=models/voices-v1.0.bin
TTS_VOICE=af_sarah
TTS_SPEED=1.0
TTS_MAX_PENDING_SENTENCES=3
# Cap on the first synthesized segment. Raising it improves prosody at the cost of first-audio latency.
TTS_FIRST_SEGMENT_MAX_CHARS=20
OPUS_BIT_RATE=32000
SPEECH_MAX_BUFFER_BYTES=480000
SPEECH_MAX_BUFFER_FRAMES=250
SPEECH_BACKPRESSURE_TIMEOUT_S=2.0

# Data retention (days). 0 = keep until manual delete; nothing is deleted unless set.
# Conservative defaults: keep attachments a month, artifacts two weeks, transcripts a quarter.
INBOX_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=14
TRANSCRIPT_RETENTION_DAYS=90
