# Copy to .env and fill in. Never commit .env.
# All endpoints are expected to be reachable on your LAN only.

# Hermes API server (OpenAI-compatible). Bind to loopback on the relay host.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me

# Local inference / speech services
LOCALAI_BASE_URL=http://127.0.0.1:8081
VOICE_BRAIN_MODEL=lfm3-audio-2b
STT_MODEL=whisper-1
TTS_MODEL=kokoro
VAD_MODEL=silero-vad

# Relay
RELAY_HOST=0.0.0.0
RELAY_PORT=8790
RELAY_TLS_CERT=/etc/hermes-talk/tls/relay.crt
RELAY_TLS_KEY=/etc/hermes-talk/tls/relay.key

# Device auth: comma-separated bearer tokens, one per device.
# Generate with: openssl rand -hex 32
DEVICE_TOKENS=device-token-1

# Storage (outside the repo)
INBOX_DIR=/var/lib/hermes-talk/inbox
OUTBOX_DIR=/var/lib/hermes-talk/outbox

# Limits
MAX_ATTACHMENT_MB=50
MAX_CALL_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
